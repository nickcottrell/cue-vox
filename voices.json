      "situations": [
        {
          "situation": "greeting",
          "ssml": "Hey. <break time=\"400ms\"/> How's it going.<break time=\"300ms\"/> <prosody pitch=\"high\">All good?</prosody>"
        },
        {
          "situation": "statement",
          "ssml": "Here's the thing. <break time=\"600ms\"/>it actually <emphasis level=\"strong\">works.</emphasis> <break time=\"300ms\"/> Every time."
        },
        {
          "situation": "question",
          "ssml": "So. <break time=\"400ms\"/> <prosody pitch=\"high\">Are we doing this?</prosody> <break time=\"300ms\"/> <prosody pitch=\"high\">Yes or no?</prosody>"
        },
        {
          "situation": "the-list",
          "ssml": "Three things. <break time=\"300ms\"/> One, <break time=\"250ms\"/> the build. <break time=\"250ms\"/> Two, <break time=\"250ms\"/> the tests. <break time=\"250ms\"/> Three, <break time=\"250ms\"/> we ship."
        },
        {
          "situation": "the-pause",
          "ssml": "I need you to hear this. <break time=\"900ms\"/> It matters. <break time=\"700ms\"/> More than the rest."
        },
        {
          "situation": "emphasis",
          "ssml": "This is <emphasis level=\"strong\">not</emphasis> a drill. <break time=\"400ms\"/> It's <emphasis level=\"strong\">real</emphasis>, and it's <emphasis level=\"strong\">now.</emphasis>"
        },
        {
          "situation": "urgent",
          "ssml": "Wait. <break time=\"250ms\"/> <prosody rate=\"fast\">Check the build, the port, the token.</prosody> <break time=\"300ms\"/> <prosody pitch=\"high\">Now?</prosody>"
        },
        {
          "situation": "reassure",
          "ssml": "Hey. <break time=\"500ms\"/> <prosody volume=\"soft\">You did the hard part.</prosody> <break time=\"400ms\"/> The rest is easy."
        },
        {
          "situation": "the-reveal",
          "ssml": "So. <break time=\"700ms\"/> Here it is. <break time=\"500ms\"/> <emphasis level=\"strong\">We did it.</emphasis> <break time=\"400ms\"/> <laugh/>"
        },
        {
          "situation": "the-aside",
          "ssml": "It works now. <break time=\"300ms\"/> <chuckle/> <break time=\"400ms\"/> <prosody volume=\"soft\">after all that.</prosody>"
        }
